# Copy this file to `.env` and fill in your real values:
#   cp .env.example .env
# Never commit the real `.env` file.

# ---------------------------------------------------------------
# LLM (ideas, script, captions) - https://console.groq.com/keys
# ---------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------
# Idea generation - Google Gemini - https://aistudio.google.com/apikey
# ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------
# Text-to-speech - https://elevenlabs.io/app/settings/api-keys
# ---------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Voice IDs for the two characters (Alex / Sam).
DEFAULT_VOICE_A=
DEFAULT_VOICE_B=

# ---------------------------------------------------------------
# Cloud storage for the rendered video and cover image
# (Supabase S3 / AWS S3 / Cloudflare R2). Use "mock" to skip uploads.
# ---------------------------------------------------------------
STORAGE_PROVIDER=mock
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_PUBLIC_BASE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---------------------------------------------------------------
# Supabase record of generated ideas (PostgREST).
# Use the project URL and the service_role key. Run supabase/schema.sql
# once in the Supabase SQL editor to create the `ideas` table.
# ---------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_IDEAS_TABLE=ideas

# ---------------------------------------------------------------
# Instagram Graph API publishing
# ---------------------------------------------------------------
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------
# true = simulate uploads and publishing (no real posts).
DRY_RUN_MODE=false
# Seconds the cover image is shown as the first frame before dialogue starts.
# Set to 0 to disable the cover intro (the cover is still used as the IG cover).
COVER_INTRO_SEC=1.5
